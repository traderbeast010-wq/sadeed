# خدمة systemd لخادم سديد (الـ API + النموذج).
# انسخها إلى /etc/systemd/system/sadeed-api.service وعدّل المسار والمستخدم.
#   sudo cp deploy/sadeed-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sadeed-api
#   journalctl -u sadeed-api -f          # لمتابعة السجلّ
[Unit]
Description=Sadeed API (FastAPI + llama.cpp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Lawmind
Environment=PYTHONIOENCODING=utf-8
Environment=LAWMIND_TOP_K=2
Environment=LD_LIBRARY_PATH=/home/ubuntu/Lawmind/llamacpp
# اضبط نطاق Vercel بعد نشر الواجهة (أو "*" للعرض المفتوح):
Environment=SADEED_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ExecStart=/home/ubuntu/Lawmind/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# النموذج يستغرق ~15ث للإقلاع البارد
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
